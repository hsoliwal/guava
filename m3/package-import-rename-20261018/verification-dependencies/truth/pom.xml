<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
<modelVersion>4.0.0</modelVersion>
<groupId>com.google.truth</groupId><artifactId>truth</artifactId><version>1.4.5-m3-relocated-20261018</version>
<name>Isolated relocated verification receiver for truth</name>
<dependencies><dependency><groupId>com.google.truth</groupId><artifactId>truth</artifactId><version>1.4.5</version></dependency></dependencies>
<build><plugins><plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-shade-plugin</artifactId><version>3.6.1</version><executions><execution><phase>package</phase><goals><goal>shade</goal></goals><configuration><createDependencyReducedPom>true</createDependencyReducedPom><useDependencyReducedPomInJar>true</useDependencyReducedPomInJar><artifactSet><excludes><exclude>com.google.guava:*</exclude></excludes></artifactSet><relocations><relocation><pattern>com.google.common</pattern><shadedPattern>com.m3.collections.guava</shadedPattern></relocation><relocation><pattern>com.google.thirdparty</pattern><shadedPattern>com.m3.collections.guava.thirdparty</shadedPattern></relocation></relocations><filters><filter><artifact>*:*</artifact><excludes><exclude>META-INF/*.SF</exclude><exclude>META-INF/*.RSA</exclude><exclude>META-INF/*.DSA</exclude><exclude>module-info.class</exclude><exclude>META-INF/versions/*/module-info.class</exclude></excludes></filter></filters><transformers><transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/><transformer implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer"/><transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer"/></transformers></configuration></execution></executions></plugin></plugins></build></project>
