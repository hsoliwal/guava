<!-- SPDX-License-Identifier: Apache-2.0 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.m3.collections.guava.verification</groupId>
  <artifactId>immutable-index-array-contract</artifactId>
  <version>20261019</version>
  <name>Finite Java 21 Guava immutable map index array contract proof</name>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Run javac on JDK 21 with the source owner's Java 8 source/class-file targets. -->
    <maven.compiler.source>8</maven.compiler.source>
    <maven.compiler.target>8</maven.compiler.target>
    <maven.deploy.skip>true</maven.deploy.skip>
    <maven.install.skip>true</maven.install.skip>
    <m3.source.root>${project.basedir}/../..</m3.source.root>
    <m3.proof.output>${project.basedir}/target</m3.proof.output>
  </properties>
  <dependencies>
    <dependency>
      <groupId>com.google.guava</groupId><artifactId>failureaccess</artifactId>
      <version>1.0.3-m3-relocated-20261018</version>
    </dependency>
    <dependency>
      <groupId>org.jspecify</groupId><artifactId>jspecify</artifactId><version>1.0.1</version>
    </dependency>
    <dependency>
      <groupId>com.google.errorprone</groupId><artifactId>error_prone_annotations</artifactId>
      <version>2.50.0</version>
    </dependency>
    <dependency>
      <groupId>com.google.j2objc</groupId><artifactId>j2objc-annotations</artifactId><version>3.1</version>
    </dependency>
    <dependency>
      <groupId>junit</groupId><artifactId>junit</artifactId><version>4.13.2</version>
    </dependency>
    <dependency>
      <groupId>com.google.truth</groupId><artifactId>truth</artifactId>
      <version>1.4.5-m3-relocated-20261018</version><scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId><artifactId>mockito-core</artifactId>
      <version>4.11.0</version><scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <directory>${m3.proof.output}</directory>
    <sourceDirectory>${m3.source.root}/guava/src</sourceDirectory>
    <testSourceDirectory>${m3.source.root}/guava-tests/test</testSourceDirectory>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId><artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.1</version>
        <executions><execution><id>unchanged-testlib</id><phase>generate-sources</phase>
          <goals><goal>add-source</goal></goals>
          <configuration><sources><source>${m3.source.root}/guava-testlib/src</source></sources></configuration>
        </execution></executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.1</version>
        <configuration>
          <proc>none</proc>
          <excludes><exclude>module-info.java</exclude></excludes>
          <testIncludes>
            <testInclude>**/HashBiMapTest.java</testInclude>
            <testInclude>**/HashMultisetTest.java</testInclude>
            <testInclude>**/LinkedHashMultisetTest.java</testInclude>
            <testInclude>**/HashMultimapTest.java</testInclude>
            <testInclude>**/ArrayListMultimapTest.java</testInclude>
            <testInclude>**/LinkedHashMultimapTest.java</testInclude>
            <testInclude>**/LinkedListMultimapTest.java</testInclude>
            <testInclude>**/MultimapBuilderTest.java</testInclude>
            <testInclude>**/ImmutableListMultimapTest.java</testInclude>
            <testInclude>**/ImmutableSetMultimapTest.java</testInclude>
            <testInclude>**/M3ArrayStorageContractTest.java</testInclude>
            <testInclude>**/ImmutableMultisetTest.java</testInclude>
            <testInclude>**/ImmutableMultisetFloodingTest.java</testInclude>
            <testInclude>**/ImmutableSortedMultisetTest.java</testInclude>
            <testInclude>**/M3ImmutableCountArrayContractTest.java</testInclude>
            <testInclude>**/ImmutableMapTest.java</testInclude>
            <testInclude>**/ImmutableBiMapTest.java</testInclude>
            <testInclude>**/ImmutableMapFloodingTest.java</testInclude>
            <testInclude>**/ImmutableBiMapFloodingTest.java</testInclude>
            <testInclude>**/M3ImmutableIndexArrayContractTest.java</testInclude>
          </testIncludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.4</version>
        <configuration>
          <argLine>-Xmx768m</argLine>
          <systemPropertyVariables>
            <m3.baseline.classes>${m3.baseline.classes}</m3.baseline.classes>
          </systemPropertyVariables>
          <includes>
            <include>**/HashBiMapTest.java</include>
            <include>**/HashMultisetTest.java</include>
            <include>**/LinkedHashMultisetTest.java</include>
            <include>**/HashMultimapTest.java</include>
            <include>**/ArrayListMultimapTest.java</include>
            <include>**/LinkedHashMultimapTest.java</include>
            <include>**/LinkedListMultimapTest.java</include>
            <include>**/MultimapBuilderTest.java</include>
            <include>**/ImmutableListMultimapTest.java</include>
            <include>**/ImmutableSetMultimapTest.java</include>
            <include>**/M3ArrayStorageContractTest.java</include>
            <include>**/ImmutableMultisetTest.java</include>
            <include>**/ImmutableMultisetFloodingTest.java</include>
            <include>**/ImmutableSortedMultisetTest.java</include>
            <include>**/M3ImmutableCountArrayContractTest.java</include>
            <include>**/ImmutableMapTest.java</include>
            <include>**/ImmutableBiMapTest.java</include>
            <include>**/ImmutableMapFloodingTest.java</include>
            <include>**/ImmutableBiMapFloodingTest.java</include>
            <include>**/M3ImmutableIndexArrayContractTest.java</include>
          </includes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
